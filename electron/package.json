{
  "name": "blueprint-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.blueprint.app",
    "productName": "Blueprint",
    "files": ["main.js"],
    "directories": { "output": "dist" },
    "mac": { "target": "dmg", "artifactName": "Blueprint-mac.${ext}" },
    "win": { "target": "nsis", "artifactName": "Blueprint-win.${ext}" },
    "linux": { "target": "AppImage", "artifactName": "Blueprint-linux.${ext}" },
    "nsis": { "artifactName": "Blueprint-win.${ext}" }
  }
}
